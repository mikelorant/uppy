<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleExecutable</key>
    <string>Uppy</string>
    <key>CFBundleIdentifier</key>
    <string>com.uppy.health-monitor</string>
    <key>CFBundleName</key>
    <string>Uppy</string>
    <key>CFBundleIconFile</key>
    <string>Uppy.icns</string>
    <key>NSAppTransportSecurity</key>
    <dict>
        <!-- Endpoints are user-defined, so fixed-domain HTTP exceptions are insufficient.
             HTTPChecker independently enforces TLS 1.2+ and blocks HTTPS downgrades.
             URLSession retains default certificate validation. -->
        <key>NSAllowsArbitraryLoads</key>
        <true/>
    </dict>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>LSMinimumSystemVersion</key>
    <string>13.0</string>
    <key>LSUIElement</key>
    <true/>
    <key>NSLocalNetworkUsageDescription</key>
    <string>Uppy checks the health of the local-network endpoints you configure.</string>
    <key>NSPrincipalClass</key>
    <string>NSApplication</string>
</dict>
</plist>
